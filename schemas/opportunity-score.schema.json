{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "davle://schemas/opportunity-score.schema.json",
  "title": "DAVLE Opportunity Score",
  "type": "object",
  "additionalProperties": false,
  "required": ["candidate_id", "dimensions", "weighted_total", "confidence", "decision"],
  "properties": {
    "candidate_id": {"type": "string", "minLength": 1},
    "dimensions": {
      "type": "object",
      "additionalProperties": false,
      "required": ["market_evidence", "trend_momentum", "demand_breadth", "saturation_headroom", "thumbnail_impact", "utility", "premium_perception", "differentiation", "implementability"],
      "properties": {
        "market_evidence": {"$ref": "#/$defs/dimension"},
        "trend_momentum": {"$ref": "#/$defs/dimension"},
        "demand_breadth": {"$ref": "#/$defs/dimension"},
        "saturation_headroom": {"$ref": "#/$defs/dimension"},
        "thumbnail_impact": {"$ref": "#/$defs/dimension"},
        "utility": {"$ref": "#/$defs/dimension"},
        "premium_perception": {"$ref": "#/$defs/dimension"},
        "differentiation": {"$ref": "#/$defs/dimension"},
        "implementability": {"$ref": "#/$defs/dimension"}
      }
    },
    "weighted_total": {"type": "number", "minimum": 0, "maximum": 100},
    "confidence": {"enum": ["high", "medium", "low"]},
    "strongest_support": {"type": "array", "items": {"type": "string"}},
    "strongest_risks": {"type": "array", "items": {"type": "string"}},
    "kill_conditions": {"type": "array", "items": {"type": "string"}},
    "decision": {"enum": ["PRODUCE", "HOLD", "DO_NOT_PRODUCE"]}
  },
  "$defs": {
    "dimension": {
      "type": "object",
      "additionalProperties": false,
      "required": ["score", "weight", "rationale"],
      "properties": {
        "score": {"type": "number", "minimum": 0, "maximum": 5},
        "weight": {"type": "number", "minimum": 0, "maximum": 100},
        "rationale": {"type": "string", "minLength": 1},
        "evidence_refs": {"type": "array", "items": {"type": "string"}}
      }
    }
  }
}
